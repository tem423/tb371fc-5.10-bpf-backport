diff --git a/include/linux/rcupdate.h b/include/linux/rcupdate.h
index cf139d6e5c1d..1cea168b4951 100644
--- a/include/linux/rcupdate.h
+++ b/include/linux/rcupdate.h
@@ -196,6 +196,37 @@ do { \
 	cond_resched(); \
