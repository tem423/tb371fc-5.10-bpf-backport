index 8c3c6323d2ed..5859edfb5ad9 100644
--- a/kernel/bpf/helpers.c
+++ b/kernel/bpf/helpers.c
@@ -457,7 +457,7 @@ static int __bpf_strtoll(const char *buf, size_t buf_len, u64 flags,
 }
 
