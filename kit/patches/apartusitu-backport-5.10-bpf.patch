diff --git a/kernel/bpf/syscall.c b/kernel/bpf/syscall.c
index 453f21c12ca6..6e779e13e2fc 100644
--- a/kernel/bpf/syscall.c
+++ b/kernel/bpf/syscall.c
@@ -1800,12 +1800,16 @@ static int bpf_raw_tracepoint_open(const union bpf_attr *attr)
 	}
 	raw_tp->btp = btp;
 
