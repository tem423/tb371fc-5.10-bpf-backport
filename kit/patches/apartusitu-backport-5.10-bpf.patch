index f74b9c3b4155..6ff565c873fd 100644
--- a/kernel/bpf/syscall.c
+++ b/kernel/bpf/syscall.c
@@ -533,8 +533,10 @@ static void bpf_map_show_fdinfo(struct seq_file *m, struct file *filp)
 
