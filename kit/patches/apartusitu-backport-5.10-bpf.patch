+			prev_prog = NULL;
+	}
 
 	memset(&xdp, 0, sizeof(xdp));
 	if (flags & XDP_FLAGS_HW_MODE)
@@ -8091,7 +8101,14 @@ static int dev_xdp_install(struct net_device *dev, bpf_op_t bpf_op,
