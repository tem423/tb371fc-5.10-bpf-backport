 net/core/filter.c                           | 16 +++++++
 tools/include/uapi/linux/bpf.h              |  1 +
 tools/testing/selftests/bpf/test_verifier.c | 46 +++++++++++----------
 4 files changed, 43 insertions(+), 21 deletions(-)

