+				}
 			}
 		} else if (!fn->check_btf_id(reg->btf_id, arg)) {
 			verbose(env, "Helper does not support %s in R%d\n",
@@ -4039,7 +4044,7 @@ static int check_func_arg(struct bpf_verifier_env *env, u32 arg,
 
