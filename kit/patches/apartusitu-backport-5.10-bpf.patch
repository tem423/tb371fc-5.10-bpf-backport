+
 #ifdef CONFIG_SECURITY
 void __init lsm_early_cred(struct cred *cred);
 #endif
 
+extern int lsm_inode_alloc(struct inode *inode);
+
 #endif /* ! __LINUX_LSM_HOOKS_H */
