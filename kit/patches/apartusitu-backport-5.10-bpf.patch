diff --git a/kernel/bpf/syscall.c b/kernel/bpf/syscall.c
index 620ac4b99f67..e53deecd4d95 100644
--- a/kernel/bpf/syscall.c
+++ b/kernel/bpf/syscall.c
@@ -356,6 +356,18 @@ static int bpf_map_release(struct inode *inode, struct file *filp)
