index d98358a96e45..fd0cfc658e59 100644
--- a/kernel/bpf/core.c
+++ b/kernel/bpf/core.c
@@ -1791,20 +1791,26 @@ static unsigned int __bpf_prog_ret0_warn(const void *ctx,
