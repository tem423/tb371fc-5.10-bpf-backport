diff --git a/kernel/bpf/btf.c b/kernel/bpf/btf.c
index 04659cf6afa8..1bdbe2bac01f 100644
--- a/kernel/bpf/btf.c
+++ b/kernel/bpf/btf.c
@@ -2,6 +2,8 @@
