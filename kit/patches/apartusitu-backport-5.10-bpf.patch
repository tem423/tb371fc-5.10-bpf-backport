--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -6973,7 +6973,7 @@ static int is_branch32_taken(struct bpf_reg_state *reg, u32 val, u8 opcode)
 	case BPF_JSGT:
 		if (reg->s32_min_value > sval)
 			return 1;
-		else if (reg->s32_max_value < sval)
+		else if (reg->s32_max_value <= sval)
 			return 0;
 		break;
 	case BPF_JLT:
@@ -7046,7 +7046,7 @@ static int is_branch64_taken(struct bpf_reg_state *reg, u64 val, u8 opcode)
