+	bpf->verifier.ops = &nfp_bpf_dev_ops;
 
 	return 0;
 
@@ -625,3 +625,4 @@ int nfp_net_bpf_offload(struct nfp_net *nn, struct bpf_prog *prog,
 
 	return 0;
 }
+
diff --git a/drivers/net/netdevsim/bpf.c b/drivers/net/netdevsim/bpf.c
