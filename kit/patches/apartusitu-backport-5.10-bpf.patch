From 0fb77bce0827141b194f8c3d36359b25c7f2c77c Mon Sep 17 00:00:00 2001
From: jsdizkcksv <3531236823@qq.com>
Date: Sun, 27 Jul 2025 20:09:43 +0800
Subject: [PATCH 1440/1444] syscall: Increase bpf fake uname to 5.10.240

* We have already backported a large number of BPF patch sets, basically
  reaching the level of 5.10, so we can deceive

Change-Id: I16c853b434767c2750456b02bf70fe49685b89cm
---
 kernel/sys.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/kernel/sys.c b/kernel/sys.c
index 4ccb49f666ac..fe24d3698749 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1276,6 +1276,14 @@ SYSCALL_DEFINE1(uname, struct old_utsname __user *, name)
 
 	down_read(&uts_sem);
 	memcpy(&tmp, utsname(), sizeof(tmp));
+	if (!strncmp(current->comm, "bpfloader", 9) ||
+	    !strncmp(current->comm, "netbpfload", 10) ||
+	    !strncmp(current->comm, "netd", 4) ||
+	    !strncmp(current->comm, "uprobestats", 11)) {
+		strcpy(tmp.release, "5.10.240");
+		pr_debug("fake uname: %s release=%s\n",
+			 current->comm, tmp.release);
+	}
 	up_read(&uts_sem);
 	if (copy_to_user(name, &tmp, sizeof(tmp)))
 		return -EFAULT;

From 3e49f6a84268d78cb20a726fd3c2ebd6584a09e2 Mon Sep 17 00:00:00 2001
From: Magnus Karlsson <magnus.karlsson@intel.com>
Date: Sun, 30 Nov 2025 13:45:07 +0800
Subject: [PATCH 1441/1444] UPSTREAM: net: add umem reference in
 netdev{_rx}_queue

These references to the umem will be used to store information
on what kind of AF_XDP umem that is bound to a queue id, if any.

Signed-off-by: Magnus Karlsson <magnus.karlsson@intel.com>
Signed-off-by: Daniel Borkmann <daniel@iogearbox.net>
(cherry picked from commit 661b8d1b0e3a745e25f05adef2ebd00d830eeea7)
Change-Id: I60a53512bcc2a04f78d59b4608cf2bbcba2e682e
Signed-off-by: zhaoyuenan <amktiao030215@gmail.com>
---
 include/linux/netdevice.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
index 02c6aba30443..1e97a321ef57 100644
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -599,6 +599,9 @@ struct netdev_queue {
 
 	/* Subordinate device that the queue has been assigned to */
 	struct net_device	*sb_dev;
+#ifdef CONFIG_XDP_SOCKETS
+	struct xdp_umem         *umem;
+#endif
 /*
  * write-mostly part
  */
@@ -736,6 +739,9 @@ struct netdev_rx_queue {
 	struct kobject			kobj;
 	struct net_device		*dev;
 	struct xdp_rxq_info		xdp_rxq;
+#ifdef CONFIG_XDP_SOCKETS
+	struct xdp_umem                 *umem;
+#endif
 
 	ANDROID_KABI_RESERVE(1);
 	ANDROID_KABI_RESERVE(2);

