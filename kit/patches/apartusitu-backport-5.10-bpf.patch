diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
index 1cb0cd0399da..8b0da3f698e9 100644
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -7848,6 +7848,38 @@ static int opt_remove_nops(struct bpf_verifier_env *env)
 	return 0;
